<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="إضافة قالب بنك / محفظة"
            android:textColor="#111827"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <!-- اختيار اسم المرسل من القائمة -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="اختر اسم المرسل من صندوق الرسائل:"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#374151"
            android:layout_marginBottom="6dp" />

        <Spinner
            android:id="@+id/spSenderList"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@android:drawable/btn_dropdown"
            android:padding="8dp"
            android:layout_marginBottom="16dp" />

        <!-- أدوات توضيحية سريعة للمستخدم -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="صيغة القالب المطلوبة:"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#374151"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="انسخ نص الرسالة واستبدل المبلغ بـ [amount] واسم المحول بـ [name]\nمثال:\nAmount [amount] JOD has been Credited to your account from [name] Using CliQ Service"
            android:textSize="12sp"
            android:textColor="#6B7280"
            android:background="#F3F4F6"
            android:padding="10dp"
            android:layout_marginBottom="12dp" />

        <!-- حقل إدخال القالب -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:hint="نمط الرسالة (Template Pattern)">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etTemplatePattern"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine"
                android:minLines="3"
                android:gravity="top" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- أزرار الإجراءات -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end">

            <Button
                android:id="@+id/btnCancel"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="إلغاء"
                android:textColor="#6B7280" />

            <Button
                android:id="@+id/btnAddTemplate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="حفظ وتفعيل 💾" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
