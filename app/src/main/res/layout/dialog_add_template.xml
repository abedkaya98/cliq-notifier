<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/glass_card_bg"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:gravity="center"
            android:text="إضافة بنك / محفظة تلقائياً"
            android:textColor="@color/text_white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- 1. اختيار المرسل -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="1. اختر اسم البنك/المرسل:"
            android:textColor="@color/primary_accent"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spSenderList"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="16dp"
            android:background="@android:drawable/btn_dropdown"
            android:padding="8dp" />

        <!-- 2. اختيار الرسالة المعنية -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="2. اختر رسالة الإيداع الحقيقية من القائمة:"
            android:textColor="@color/primary_accent"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spSmsMessages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@android:drawable/btn_dropdown"
            android:minHeight="48dp"
            android:padding="8dp" />

        <!-- معاينة القالب التلقائي -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="القالب الذي تم توليده تلقائياً:"
            android:textColor="@color/text_gray"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvAutoGeneratedTemplate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:background="@color/glass_input_bg"
            android:padding="12dp"
            android:text="اختر رسالة لإظهار القالب الأوتوماتيكي..."
            android:textColor="@color/accent_green"
            android:textSize="12sp" />

        <!-- أزرار الإجراءات -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnCancel"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="إلغاء"
                android:textColor="@color/text_gray" />

            <Button
                android:id="@+id/btnAddTemplate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:backgroundTint="@color/primary_button"
                android:text="حفظ وتفعيل 💾"
                android:textColor="@color/text_white" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
